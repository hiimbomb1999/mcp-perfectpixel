{
  "name": "mcp-perfectpixel-monorepo",
  "version": "0.1.3",
  "private": true,
  "description": "Monorepo for mcp-perfectpixel — a codebase-grounded design-to-code diff server for the Model Context Protocol",
  "license": "MIT",
  "author": "Danh Huynh (https://github.com/hiimbomb1999)",
  "homepage": "https://github.com/hiimbomb1999/mcp-perfectpixel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiimbomb1999/mcp-perfectpixel.git"
  },
  "bugs": {
    "url": "https://github.com/hiimbomb1999/mcp-perfectpixel/issues"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r build && vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
